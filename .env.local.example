# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Without these the app runs in demo mode.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only. Used by scripts/seed.mjs to load the curriculum.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI backend (the tutor + brutally-honest examiner) ---
# Prepify is "bring your own key": each student pastes their own free Groq API
# key in the app (Settings → Connect your AI), stored only in their browser.
#
# The variable below is OPTIONAL — a shared server-side fallback key for local
# dev/testing only. In production, leave it unset and let users bring their own.
# GROQ_API_KEY=gsk_...

# Optional. Defaults to llama-3.3-70b-versatile. Set to a faster/smaller model
# such as llama-3.1-8b-instant, or any current Groq model id.
# PREPIFY_MODEL=llama-3.1-8b-instant
