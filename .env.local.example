# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Without these the app runs in demo mode.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only. Used by scripts/seed.mjs to load the curriculum.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI backend (the "Ask Prepify" chatbot) ---
# ONE shared Groq API key powers the chatbot for every student, so nobody has
# to set anything up. Create a free key at https://console.groq.com/keys and
# set it here (and in the hosting provider's environment variables).
#
# Tests do NOT use this key — questions are sampled from the `questions` table,
# so test-taking keeps working even if the key is missing or rate-limited.
# GROQ_API_KEY=gsk_...

# Optional. When unset, the best model the key can access is discovered at
# runtime. Set this to pin one, e.g. llama-3.1-8b-instant.
# PREPIFY_MODEL=llama-3.1-8b-instant
