# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Without these the app runs in demo mode.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only. Used by scripts/seed.mjs to load the curriculum.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI backend (the tutor + brutally-honest examiner) ---
# Server-side only. Without it the app falls back to canned tutor/grading.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5. Set to a cheaper/faster model such as
# claude-sonnet-5 or claude-haiku-4-5 to trade quality for cost.
# PREPIFY_MODEL=claude-sonnet-5
