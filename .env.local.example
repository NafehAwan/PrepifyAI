# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Without these the app runs in demo mode.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only. Used by scripts/seed.mjs to load the curriculum.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
